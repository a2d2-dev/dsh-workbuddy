{
  "name": "dsh-workbuddy",
  "version": "0.1.0",
  "description": "WorkBuddy account sign-in and remote model provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" }, "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib/*.js", "lib/*.d.ts", "server/*.py", "!server/test_*.py", "docs/screenshots/*.png", "docs/OPERATIONS.md", "deploy/README.md", "deploy/Caddyfile", "deploy/gateway.env.example", "deploy/workbuddy2api.conf", "deploy/verify_gateway.py", "pyproject.toml", "uv.lock", "cordis.patch.yml", "README*.md", "CONTRIBUTING.md", "SECURITY.md", "SUPPORT.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"], "platform": "web" }
  },
  "scripts": { "build": "tsc && node build-client.mjs", "typecheck": "tsc --noEmit", "test": "vitest run", "check:package": "node scripts/check-package.mjs", "prepack": "pnpm build" },
  "packageManager": "pnpm@10.4.1",
  "repository": { "type": "git", "url": "git+https://github.com/a2d2-dev/dsh-workbuddy.git" },
  "homepage": "https://github.com/a2d2-dev/dsh-workbuddy#readme",
  "bugs": { "url": "https://github.com/a2d2-dev/dsh-workbuddy/issues" },
  "keywords": ["dsh", "deepseek-harness", "workbuddy", "llm", "tool-calling"],
  "license": "Apache-2.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "^18.3.1", "typescript": "^5.9.2", "esbuild": "^0.25.0", "vitest": "^4.1.8"
  }
}
